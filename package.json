{
  "name": "controle-manutencao-veiculos",
  "version": "1.0.0",
  "description": "Sistema de controle de manutencao de veiculos - NestJS + Handlebars",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/banco/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/banco/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/banco/data-source.ts",
    "test": "npm run build && node --test tests/*.test.cjs",
    "schema:check": "npm run build && node scripts/verificar-schema.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "express-session": "^1.19.0",
    "hbs": "^4.2.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
