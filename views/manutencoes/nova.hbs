{{!< ../layout}}
<h1 class="titulo-pagina">Registrar manutenção</h1>
<p class="apoio">Os dados ficam guardados em memória enquanto a aplicação estiver rodando.</p>

<form class="formulario" method="POST" action="/manutencoes">
  <label>
    Veículo
    <select name="veiculoId" required>
      {{#each veiculos}}
        <option value="{{this.id}}">{{this.apelido}} ({{this.modelo}})</option>
      {{/each}}
    </select>
  </label>

  <label>
    Tipo de serviço
    <input type="text" name="tipo" placeholder="Troca de óleo" required>
  </label>

  <label class="largo">
    Descrição
    <textarea name="descricao" rows="3" placeholder="O que foi feito ou precisa ser feito"></textarea>
  </label>

  <label>
    Oficina
    <input type="text" name="oficina" placeholder="Nome da oficina">
  </label>

  <label>
    Data
    <input type="date" name="data" required>
  </label>

  <label>
    Quilometragem
    <input type="number" name="km" min="0" placeholder="68000" required>
  </label>

  <label>
    Custo (R$)
    <input type="number" name="custo" min="0" step="0.01" placeholder="320.00" required>
  </label>

  <label>
    Status
    <select name="status">
      <option value="Agendada">Agendada</option>
      <option value="Em andamento">Em andamento</option>
      <option value="Concluída">Concluída</option>
    </select>
  </label>

  <div class="acoes">
    <button type="submit" class="botao">Salvar manutenção</button>
    <a class="link-secundario" href="/manutencoes">Cancelar</a>
  </div>
</form>
