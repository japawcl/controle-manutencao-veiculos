{{!< ../layout}}
<h1 class="titulo-pagina">Registrar manutenção</h1>
<p class="apoio">Toda manutenção nasce com o status "Agendada", definido pela aplicação.</p>

<form class="formulario" method="POST" action="/manutencoes">
  {{> campos}}

  <div class="acoes">
    <button type="submit" class="botao">Salvar manutenção</button>
    <a class="link-secundario" href="/manutencoes">Cancelar</a>
  </div>
</form>
