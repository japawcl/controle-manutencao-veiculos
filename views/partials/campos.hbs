<label for="veiculoId">
  Veículo
  <select id="veiculoId" name="veiculoId" class="{{#if erros.veiculoId}}campo-erro{{/if}}" required>
    <option value="">Selecione um veículo</option>
    {{#each veiculos}}
      <option value="{{this.id}}" {{#if (eq @root.manutencao.veiculoId this.id)}}selected{{/if}}>
        {{this.apelido}} ({{this.modelo}})
      </option>
    {{/each}}
  </select>
  {{#if erros.veiculoId}}<span class="mensagem-erro">{{erros.veiculoId}}</span>{{/if}}
</label>

<label for="tipo">
  Tipo de serviço
  <input type="text" id="tipo" name="tipo" placeholder="Troca de óleo" value="{{manutencao.tipo}}"
    class="{{#if erros.tipo}}campo-erro{{/if}}" required maxlength="100" minlength="3">
  {{#if erros.tipo}}<span class="mensagem-erro">{{erros.tipo}}</span>{{/if}}
</label>

<label class="largo" for="descricao">
  Descrição
  <textarea id="descricao" name="descricao" rows="3" placeholder="O que foi feito ou precisa ser feito"
    class="{{#if erros.descricao}}campo-erro{{/if}}" maxlength="1000">{{manutencao.descricao}}</textarea>
  {{#if erros.descricao}}<span class="mensagem-erro">{{erros.descricao}}</span>{{/if}}
</label>

<label for="oficina">
  Oficina
  <input type="text" id="oficina" name="oficina" placeholder="Nome da oficina" value="{{manutencao.oficina}}"
    class="{{#if erros.oficina}}campo-erro{{/if}}" maxlength="120">
  {{#if erros.oficina}}<span class="mensagem-erro">{{erros.oficina}}</span>{{/if}}
</label>

<label for="data">
  Data
  <input type="date" id="data" name="data" value="{{manutencao.data}}"
    data-data-manutencao data-hoje="{{hoje}}" data-data-original="{{dataOriginal}}" data-status-original="{{statusOriginal}}"
    class="{{#if erros.data}}campo-erro{{/if}}" required>
  {{#if erros.data}}<span class="mensagem-erro">{{erros.data}}</span>{{/if}}
</label>

<label for="km">
  Quilometragem do serviço (prevista no agendamento)
  <input type="number" id="km" name="km" min="0" max="2147483647" step="1" placeholder="68000" value="{{manutencao.km}}"
    class="{{#if erros.km}}campo-erro{{/if}}" required>
  {{#if erros.km}}<span class="mensagem-erro">{{erros.km}}</span>{{/if}}
</label>

<label for="custo">
  Custo (R$)
  <input type="text" inputmode="decimal" data-moeda id="custo" name="custo" maxlength="20" placeholder="320,00" value="{{manutencao.custo}}"
    class="{{#if erros.custo}}campo-erro{{/if}}" required>
  <small>Exemplos: 100,50 ou 1.234,56. Até duas casas decimais.</small>
  {{#if erros.custo}}<span class="mensagem-erro">{{erros.custo}}</span>{{/if}}
</label>

<fieldset class="largo caixa-pecas">
  <legend>Peças utilizadas</legend>
  <div class="pecas-grade">
    {{#each pecas}}
      <label class="peca-item" for="peca-{{this.id}}">
        <input id="peca-{{this.id}}" type="checkbox" name="pecas" value="{{this.id}}"
          {{#if (contem @root.pecasSelecionadas this.id)}}checked{{/if}}>
        <span>{{this.nome}}</span>
      </label>
    {{/each}}
  </div>
</fieldset>
