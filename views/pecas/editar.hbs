<section aria-label="Editar peça"><h1>Editar peça</h1>
<form class="formulario" data-validar method="post" action="/pecas/{{peca.id}}/editar">
<label for="nome">Nome da peça<input id="nome" name="nome" value="{{peca.nome}}" required minlength="2" maxlength="80" class="{{#if erros.nome}}campo-erro{{/if}}">{{#if erros.nome}}<span class="mensagem-erro">{{erros.nome}}</span>{{/if}}</label>
<div class="acoes"><button class="botao" type="submit">Salvar alterações</button><a href="/pecas">Cancelar</a></div></form></section>