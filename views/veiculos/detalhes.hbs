<section aria-label="Detalhes"><h1>Detalhes de veículo</h1><dl><dt>Apelido</dt><dd>{{veiculo.apelido}}</dd><dt>Marca</dt><dd>{{veiculo.marca}}</dd><dt>Modelo</dt><dd>{{veiculo.modelo}}</dd><dt>Placa</dt><dd>{{veiculo.placa}}</dd><dt>Ano</dt><dd>{{veiculo.ano}}</dd><dt>Quilometragem</dt><dd>{{veiculo.kmAtual}}</dd></dl><a class="botao" href="/veiculos/{{veiculo.id}}/editar">Editar</a> <a href="/veiculos">Voltar</a><h2>Histórico de manutenções</h2><ul>{{#each manutencoes}}<li><a href="/manutencoes/{{this.id}}">{{this.tipo}}</a> — {{data this.data}} — {{moeda this.custo}}</li>{{else}}<li>Nenhuma manutenção.</li>{{/each}}</ul></section>