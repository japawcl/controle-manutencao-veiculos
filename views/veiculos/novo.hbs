{{!< ../layout}}
<a class="voltar" href="/veiculos">Voltar para a lista</a>

<h1 class="titulo-pagina">Cadastrar veículo</h1>
<p class="apoio">O veículo passa a estar disponível para receber manutenções.</p>

<form class="formulario" method="POST" action="/veiculos">
  <label>
    Apelido
    <input type="text" name="apelido" placeholder="Carro da família" value="{{veiculo.apelido}}"
      class="{{#if erros.apelido}}campo-erro{{/if}}">
    {{#if erros.apelido}}<span class="mensagem-erro">{{erros.apelido}}</span>{{/if}}
  </label>

  <label>
    Marca
    <input type="text" name="marca" placeholder="Fiat" value="{{veiculo.marca}}"
      class="{{#if erros.marca}}campo-erro{{/if}}">
    {{#if erros.marca}}<span class="mensagem-erro">{{erros.marca}}</span>{{/if}}
  </label>

  <label>
    Modelo
    <input type="text" name="modelo" placeholder="Argo Drive 1.0" value="{{veiculo.modelo}}"
      class="{{#if erros.modelo}}campo-erro{{/if}}">
    {{#if erros.modelo}}<span class="mensagem-erro">{{erros.modelo}}</span>{{/if}}
  </label>

  <label>
    Placa
    <input type="text" name="placa" placeholder="ABC-1D23" value="{{veiculo.placa}}"
      class="{{#if erros.placa}}campo-erro{{/if}}">
    {{#if erros.placa}}<span class="mensagem-erro">{{erros.placa}}</span>{{/if}}
  </label>

  <label>
    Ano
    <input type="number" name="ano" min="1950" max="2100" placeholder="2021" value="{{veiculo.ano}}"
      class="{{#if erros.ano}}campo-erro{{/if}}">
    {{#if erros.ano}}<span class="mensagem-erro">{{erros.ano}}</span>{{/if}}
  </label>

  <label>
    Quilometragem atual
    <input type="number" name="kmAtual" min="0" placeholder="68000" value="{{veiculo.kmAtual}}"
      class="{{#if erros.kmAtual}}campo-erro{{/if}}">
    {{#if erros.kmAtual}}<span class="mensagem-erro">{{erros.kmAtual}}</span>{{/if}}
  </label>

  <div class="acoes">
    <button type="submit" class="botao">Salvar veículo</button>
    <a class="link-secundario" href="/veiculos">Cancelar</a>
  </div>
</form>
